{
  "expo": {
    "name": "HelpMate",
    "slug": "help-marketplace",
    "scheme": "help",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./public/logo512.png",
    "splash": {
      "image": "./public/logo512.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.help.app"
    },
    "android": {
      "package": "br.com.help.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/logo512.png",
        "backgroundColor": "#FBF9F6"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O HelpMate usa sua localização pra te mostrar pedidos de serviço próximos quando você está online como autônomo."
        }
      ],
      "expo-font"
    ]
  }
}
